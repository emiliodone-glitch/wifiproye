# Copia este archivo como .env y cambia los valores.

# Puerto donde escucha el servidor
PORT=3000

# Usuario y contraseña para entrar al panel /admin (¡cámbialos!)
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# ---------- Router Datto Networking (AP440) ----------
# Deben ser IGUALES a los que pongas en Datto Network Manager > SSID > Captive Portal.
# Inventa dos claves largas y distintas (por ejemplo con: openssl rand -hex 16).
DATTO_UAM_SECRET=
DATTO_AUTH_SECRET=
# Clave interna para firmar accesos (cualquier texto largo y secreto)
FIRMA_SECRETO=
# Minutos que dura cada sesión. Al vencer, la persona vuelve a ver el portal
# (y se le pide el siguiente dato). Las personas con todos sus datos entran directo.
SESION_MINUTOS=120
AUTO_CONECTAR_COMPLETOS=si
# Velocidad máxima por persona (kilobits por segundo)
BAJADA_KBPS=5000
SUBIDA_KBPS=2000

# ---------- Router MikroTik (solo si usas MikroTik en vez de Datto) ----------
# Usuario de hotspot que se crea en el MikroTik (debe coincidir con router/mikrotik/configurar.rsc)
HOTSPOT_USER=invitado
HOTSPOT_PASS=cambia-esta-clave-tambien

# Dónde se guarda la base de datos
DB_PATH=./data/registros.db

# Textos de la página
PIE_TEXTO=Aporte Secretaría de Operaciones
ORG_NAME=Mi Organización
WIFI_NAME=WiFi Gratis
PRIVACY_URL=/privacidad
# A dónde mandar a la persona después de conectarse si el router no indica otra página
DEFAULT_REDIRECT=https://www.google.com
